      "term": "Shot clock",
      "definition": "The timer that forces a team to shoot before it runs out; the length depends on the league.",
      "exampleLine": "We are burning the shot clock and still have nothing.",
      "tier": "foundations"
    },
    {
      "id": "halves-vs-quarters",
      "term": "Halves vs quarters",
      "definition": "NBA and WNBA games are split into four quarters; men's college games are split into two halves.",
      "exampleLine": "College plays halves, so the break comes later.",
      "tier": "branch"
    },
    {
      "id": "play-in",
      "term": "Play-In",
      "definition": "A short tournament that decides the last playoff spots in each NBA conference.",
      "exampleLine": "They are stuck in the Play-In race this year.",
