{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.swoond.app/native-exercises/v1/term-match.schema.json",
  "title": "Native exercise payload - term-match",
  "description": "Match 3-6 terms to definitions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "prompt",
    "pairs",
    "explanation"
  ],
  "properties": {
    "prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "description": "Display M serif line. Design rule: 12 words or fewer."
    },
    "pairs": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "term",
          "definition"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "term": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "definition": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        }
      }
    },
    "distractorDefinitions": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "explanation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400,
          "description": "Shown after matching."
        },
        "sayThisLine": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    }
  }
}
