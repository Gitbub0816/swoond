{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.swoond.app/native-exercises/v1/visual-id.schema.json",
  "title": "Native exercise payload - visual-id",
  "description": "Identify what is shown in an image.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "prompt",
    "image",
    "options",
    "correctOptionId",
    "explanation"
  ],
  "properties": {
    "prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "description": "Display M serif line. Design rule: 12 words or fewer."
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset",
        "alt",
        "license"
      ],
      "properties": {
        "asset": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._/-]*$",
          "description": "Bundle-relative asset path (content pack), never an absolute URL."
        },
        "alt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "description": "Accessibility description (VoiceOver)."
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "License id from the content pack license registry."
        },
        "attribution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    },
    "options": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 140
          },
          "explanation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "description": "Per-option note shown after answering."
          },
          "image": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._/-]*$",
            "description": "Bundle-relative asset path (content pack), never an absolute URL."
          }
        }
      }
    },
    "correctOptionId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "explanation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "correct",
        "incorrect"
      ],
      "properties": {
        "correct": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400,
          "description": "Feedback body when right (title \"Nice read.\" is added by the app). Teach how it works, not just the rule name."
        },
        "incorrect": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400,
          "description": "Feedback body when wrong (title \"Not quite.\")."
        },
        "sayThisLine": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "Optional line you could say out loud; shown serif in quotes."
        }
      }
    },
    "cues": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      },
      "description": "Distinguishing features to teach (bulleted in feedback)."
    }
  }
}
