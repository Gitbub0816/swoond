{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.swoond.app/native-exercises/v1/multiple-choice.schema.json",
  "title": "Native exercise payload - multiple-choice",
  "description": "One prompt, 2-5 text options, one or more correct.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "prompt",
    "options",
    "correctOptionIds",
    "explanation"
  ],
  "properties": {
    "prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "description": "Display M serif line. Design rule: 12 words or fewer."
    },
    "options": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 140
          },
          "explanation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "description": "Per-option note shown after answering."
          }
        }
      }
    },
    "correctOptionIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      }
    },
    "allowMultiple": {
      "type": "boolean",
      "default": false
    },
    "shuffle": {
      "type": "boolean",
      "default": true
    },
    "explanation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "correct",
        "incorrect"
      ],
      "properties": {
        "correct": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400,
          "description": "Feedback body when right (title \"Nice read.\" is added by the app). Teach how it works, not just the rule name."
        },
        "incorrect": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400,
          "description": "Feedback body when wrong (title \"Not quite.\")."
        },
        "sayThisLine": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "Optional line you could say out loud; shown serif in quotes."
        }
      }
    }
  }
}
