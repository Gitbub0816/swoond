    {
      "area": "audio",
      "constraint": "Only original synthesized audio (spotter calls, cues); no broadcast audio, driver radio or licensed engine recordings."
    },
    {
      "area": "article-text",
      "constraint": "Never copy publisher text; explain in our own words and link."
    },
    {
      "area": "data-provider-terms",
      "constraint": "Licensed providers only, behind Swoon'd adapters; no scraping of NASCAR.com or Racing-Reference."
