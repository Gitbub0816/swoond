      "area": "imagery",
      "constraint": "Procedural or original diagrams only; every asset carries a license id."
    },
    {
      "area": "video",
      "constraint": "No embedded match video or GIFs; link to official channels only where terms allow."
    },
    {
      "area": "audio",
      "constraint": "No chants or commentary audio; original synthesized cues only."
    },
    {
      "area": "article-text",
      "constraint": "Never copy publisher text; explain in our own words and link."
    },
    {
      "area": "data-provider-terms",
      "constraint": "Follow each provider's terms and attribution; no scraping of official sites; no unofficial APIs."
    },
