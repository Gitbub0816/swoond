{
  "contractVersion": "1.1.0",
  "courseId": "american-football",
  "unit": {
    "id": "the-basics",
    "title": "The basics",
    "summary": "Downs, the clock and who does what.",
    "layer": "foundations",
    "order": 0,
    "lessons": [
      {
        "id": "downs-01",
        "title": "Four downs",
        "objective": "You can explain what a down is and why fourth down matters.",
        "estimatedMinutes": 4,
        "conceptIds": [
          "downs",
          "game-clock",
          "quarterback"
        ],
        "activities": [
          {
            "id": "downs-01-mc",
            "type": "multiple-choice",
            "conceptIds": [
              "downs"
            ],
            "payload": {
              "prompt": "How many downs does the offense get to gain 10 yards?",
              "options": [
                {
                  "id": "a",
                  "text": "Three"
                },
                {
                  "id": "b",
                  "text": "Four"
                },
                {
                  "id": "c",
                  "text": "Five"
                }
              ],
              "correctOptionIds": [
                "b"
              ],
              "explanation": {
                "correct": "Four tries to move the ball 10 yards. Gain them and the count resets to first down.",
                "incorrect": "It is four downs. Most teams punt on fourth down instead of gambling.",
                "sayThisLine": "They should have gone for it on fourth down."
              }
            }
          },
          {
            "id": "downs-01-gap",
            "type": "fill-the-gap",
            "conceptIds": [
              "downs"
            ],
            "payload": {
              "prompt": "Complete the sentence.",
              "template": "On {{down}}, the offense must gain {{yards}} yards for a new set of downs.",
              "gaps": [
                {
                  "id": "down",
                  "options": [
                    "first",
                    "fourth"
                  ],
                  "correct": "fourth"
                },
                {
                  "id": "yards",
                  "options": [
                    "5",
                    "10"
                  ],
                  "correct": "10"
                }
              ],
              "explanation": {
                "correct": "That is why fourth down is such a big decision.",
                "incorrect": "The offense always needs 10 yards total; fourth is the last try."
              }
            }
          },
          {
            "id": "clock-01-est",
            "type": "estimate-slider",
            "conceptIds": [
              "game-clock"
            ],
            "payload": {
              "prompt": "How long is an NFL game clock?",
              "unit": "minutes",
              "min": 30,
              "max": 120,
              "step": 5,
              "correctValue": 60,
              "tolerance": {
                "full": 5,
                "partial": 15
              },
              "explanation": {
                "correct": "Four 15-minute quarters. Real time is about three hours because the clock stops.",
                "incorrect": "Four 15-minute quarters make 60 minutes of game clock. The clock stops a lot."
              }
            }
          },
          {
            "id": "positions-01-match",
            "type": "term-match",
            "conceptIds": [
              "quarterback"
            ],
            "payload": {
              "prompt": "Match the position to its job.",
              "pairs": [
                {
                  "id": "qb",
                  "term": "Quarterback",
                  "definition": "Runs the offense and throws the ball"
                },
                {
                  "id": "cb",
                  "term": "Cornerback",
                  "definition": "Covers wide receivers"
                },
                {
                  "id": "k",
                  "term": "Kicker",
                  "definition": "Kicks field goals and extra points"
                }
              ],
              "explanation": {
                "summary": "Offense scores, defense stops, special teams handles the kicking game."
              }
            }
          }
        ]
      }
    ]
  }
}
