{
  "contractVersion": "1.0.0",
  "courseId": "american-football",
  "curriculumVersion": "0.1.0",
  "locale": "en-US",
  "concepts": [
    {
      "id": "downs",
      "term": "Downs",
      "definition": "The offense gets four plays (downs) to gain 10 yards. Gain them and the count resets.",
      "exampleLine": "They have to go for it on fourth down.",
      "tier": "foundations"
    },
    {
      "id": "quarterback",
      "term": "Quarterback",
      "definition": "The player who runs the offense and throws most passes.",
      "exampleLine": "Their quarterback looks calm under pressure.",
      "tier": "foundations",
      "relatedConceptIds": [
        "downs"
      ]
    },
    {
      "id": "game-clock",
      "term": "Game clock",
      "definition": "Sixty minutes of playing time in four quarters; the clock stops often, so games take about three hours.",
      "exampleLine": "They are just trying to run out the clock.",
      "tier": "foundations"
    },
    {
      "id": "secondary",
      "term": "Secondary",
      "definition": "The defensive backs: cornerbacks and safeties who cover receivers.",
      "exampleLine": "Our secondary is getting torched.",
      "tier": "intermediate",
      "aliases": [
        "defensive backs",
        "DBs"
      ]
    },
    {
      "id": "cover-3",
      "term": "Cover 3",
      "definition": "A zone defense where three defenders split the deep part of the field into thirds.",
      "exampleLine": "They are sitting in Cover 3 and giving up the short stuff.",
      "tier": "intermediate",
      "relatedConceptIds": [
        "secondary"
      ]
    },
    {
      "id": "strong-safety",
      "term": "Strong safety",
      "definition": "The safety who lines up on the tight end side and helps against the run and short passes.",
      "exampleLine": "The strong safety came up to stop the run.",
      "tier": "intermediate",
      "relatedConceptIds": [
        "secondary"
      ]
    }
  ],
  "units": [
    {
      "id": "the-basics",
      "title": "The basics",
      "summary": "Downs, the clock and who does what.",
      "layer": "foundations",
      "order": 0,
      "lessons": [
        {
          "id": "downs-01",
          "title": "Four downs",
          "objective": "You can explain what a down is and why fourth down matters.",
          "estimatedMinutes": 4,
          "conceptIds": [
            "downs"
          ],
          "activities": [
            {
              "id": "downs-01-mc",
              "type": "multiple-choice",
              "conceptIds": [
                "downs"
              ],
              "payload": {
                "prompt": "How many downs does the offense get to gain 10 yards?",
                "options": [
                  {
                    "id": "a",
                    "text": "Three"
                  },
                  {
                    "id": "b",
                    "text": "Four"
                  },
                  {
                    "id": "c",
                    "text": "Five"
                  }
                ],
                "correctOptionIds": [
                  "b"
                ],
                "explanation": {
                  "correct": "Four tries to move the ball 10 yards. Gain them and the count resets to first down.",
                  "incorrect": "It is four downs. Most teams punt on fourth down instead of gambling.",
                  "sayThisLine": "They should have gone for it on fourth down."
                }
              }
            },
            {
              "id": "downs-01-gap",
              "type": "fill-the-gap",
              "conceptIds": [
                "downs"
              ],
              "payload": {
                "prompt": "Complete the sentence.",
                "template": "On {{down}}, the offense must gain {{yards}} yards for a new set of downs.",
                "gaps": [
                  {
                    "id": "down",
                    "options": [
                      "first",
                      "fourth"
                    ],
                    "correct": "fourth"
                  },
                  {
                    "id": "yards",
                    "options": [
                      "5",
                      "10"
                    ],
                    "correct": "10"
                  }
                ],
                "explanation": {
                  "correct": "That is why fourth down is such a big decision.",
                  "incorrect": "The offense always needs 10 yards total; fourth is the last try."
                }
              }
            }
          ]
        },
        {
          "id": "clock-01",
          "title": "The clock",
          "objective": "You can say how long a game is and why it feels longer.",
          "estimatedMinutes": 3,
          "conceptIds": [
            "game-clock"
          ],
          "activities": [
            {
              "id": "clock-01-est",
              "type": "estimate-slider",
              "conceptIds": [
                "game-clock"
              ],
              "payload": {
                "prompt": "How long is an NFL game clock?",
                "unit": "minutes",
                "min": 30,
                "max": 120,
                "step": 5,
                "correctValue": 60,
                "tolerance": {
                  "full": 5,
                  "partial": 15
                },
                "explanation": {
                  "correct": "Four 15-minute quarters. Real time is about three hours because the clock stops.",
                  "incorrect": "Four 15-minute quarters make 60 minutes of game clock. The clock stops a lot."
                }
              }
            }
          ]
        },
        {
          "id": "positions-01",
          "title": "Who does what",
          "objective": "You can match key positions to their jobs.",
          "estimatedMinutes": 4,
          "conceptIds": [
            "quarterback"
          ],
          "activities": [
            {
              "id": "positions-01-match",
              "type": "term-match",
              "conceptIds": [
                "quarterback"
              ],
              "payload": {
                "prompt": "Match the position to its job.",
                "pairs": [
                  {
                    "id": "qb",
                    "term": "Quarterback",
                    "definition": "Runs the offense and throws the ball"
                  },
                  {
                    "id": "cb",
                    "term": "Cornerback",
                    "definition": "Covers wide receivers"
                  },
                  {
                    "id": "k",
                    "term": "Kicker",
                    "definition": "Kicks field goals and extra points"
                  }
                ],
                "explanation": {
                  "summary": "Offense scores, defense stops, special teams handles the kicking game."
                }
              }
            }
          ]
        }
      ]
    },
    {
      "id": "defense-basics",
      "title": "Reading the defense",
      "summary": "Secondary, coverages and what fans mean.",
      "layer": "intermediate",
      "order": 1,
      "prerequisiteUnitIds": [
        "the-basics"
      ],
      "lessons": [
        {
          "id": "coverage-04",
          "title": "Reading coverage",
          "objective": "You can spot a three-deep zone.",
          "estimatedMinutes": 6,
          "conceptIds": [
            "cover-3",
            "strong-safety"
          ],
          "activities": [
            {
              "id": "coverage-04-hot",
              "type": "hotspot-tap",
              "conceptIds": [
                "strong-safety"
              ],
              "payload": {
                "prompt": "Tap where the strong safety lines up.",
                "diagram": {
                  "diagramId": "football-formation-cover-3",
                  "aspectRatio": 1.2,
                  "alt": "Overhead diagram of a defensive formation with three deep defenders."
                },
                "hotspots": [
                  {
                    "id": "ss",
                    "label": "Strong safety",
                    "shape": {
                      "kind": "circle",
                      "cx": 0.62,
                      "cy": 0.3,
                      "r": 0.06
                    }
                  },
                  {
                    "id": "fs",
                    "label": "Free safety",
                    "shape": {
                      "kind": "circle",
                      "cx": 0.4,
                      "cy": 0.2,
                      "r": 0.06
                    }
                  }
                ],
                "correctHotspotIds": [
                  "ss"
                ],
                "explanation": {
                  "correct": "The strong safety sits on the side of the tight end.",
                  "incorrect": "Find the tight end: the strong safety lines up on that side."
                }
              }
            },
            {
              "id": "coverage-04-sim",
              "type": "unity-sim",
              "conceptIds": [
                "cover-3"
              ],
              "payload": {
                "simulationId": "football.coverage.read.v1",
                "simulationVersion": "1.0.0",
                "difficulty": 2,
                "configuration": {
                  "scenarioCount": 3
                }
              }
            }
          ]
        },
        {
          "id": "talk-secondary",
          "title": "Talking about the secondary",
          "objective": "You can decode a fan complaining about the secondary.",
          "estimatedMinutes": 3,
          "conceptIds": [
            "secondary"
          ],
          "activities": [
            {
              "id": "talk-secondary-say",
              "type": "say-this",
              "conceptIds": [
                "secondary"
              ],
              "payload": {
                "statement": {
                  "speaker": "Sarah",
                  "text": "Our secondary is absolutely killing us this year."
                },
                "question": "What is she talking about?",
                "options": [
                  {
                    "id": "a",
                    "text": "The defensive backs",
                    "isCorrect": true
                  },
                  {
                    "id": "b",
                    "text": "The kicker",
                    "isCorrect": false
                  },
                  {
                    "id": "c",
                    "text": "Pass coverage",
                    "isCorrect": true
                  },
                  {
                    "id": "d",
                    "text": "The stadium staff",
                    "isCorrect": false
                  }
                ],
                "translation": "The players defending against passes are playing badly, and the team is losing because of it.",
                "followUps": [
                  {
                    "line": "Is it the cornerbacks or the safeties?",
                    "why": "Shows you know the secondary has two position groups."
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "talkTracks": [
    {
      "id": "game-night-text",
      "title": "Game night text",
      "unlockedByUnitId": "the-basics",
      "conceptIds": [
        "downs"
      ],
      "payload": {
        "title": "Hockey night",
        "setting": "She texts after her team wins in overtime.",
        "startingSmooth": 50,
        "exchanges": [
          {
            "theirMessage": "OT winner!! Power play goal, we finally got the man advantage.",
            "replies": [
              {
                "id": "a",
                "text": "Nice, the power play finally clicked?",
                "smoothDelta": 30,
                "theirResponse": "YES. It had been 0 for 14.",
                "coachNote": "You picked up the term and asked about it."
              },
              {
                "id": "b",
                "text": "Cool, so who won?",
                "smoothDelta": -20,
                "theirResponse": "...We did. It is in my text.",
                "coachNote": "Read her message first."
              }
            ]
          }
        ],
        "closingNote": "A power play is a two-minute man advantage after a penalty."
      }
    }
  ],
  "reviewPolicy": {
    "algorithm": "leitner-boxes-v1",
    "intervalsDays": [
      1,
      3,
      7,
      14,
      30,
      60
    ],
    "maxItemsPerSession": 10,
    "masteryThreshold": 0.8,
    "decayAfterDays": 45,
    "reviewActivityTypes": [
      "multiple-choice",
      "fill-the-gap",
      "term-match",
      "say-this"
    ]
  }
}