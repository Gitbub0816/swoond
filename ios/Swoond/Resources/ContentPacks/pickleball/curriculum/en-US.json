  "locale": "en-US",
  "concepts": [
    {
      "id": "kitchen",
      "term": "The kitchen",
      "definition": "The non-volley zone: the 7 feet on each side of the net where you can't hit the ball out of the air.",
      "exampleLine": "Stay out of the kitchen!",
      "tier": "foundations",
      "aliases": [
        "non-volley zone"
      ]
    },
    {
      "id": "two-bounce",
      "term": "Two-bounce rule",
      "definition": "The serve and the return must each bounce before anyone volleys.",
      "exampleLine": "That's the two-bounce rule.",
      "tier": "foundations"
    },
    {
      "id": "volley",
      "term": "Volley",
      "definition": "Hitting the ball out of the air without letting it bounce.",
      "exampleLine": "Nice volley at the net.",
      "tier": "foundations"
    },
    {
      "id": "dink",
      "term": "Dink",
      "definition": "A soft shot that just clears the net and lands in the kitchen.",
      "exampleLine": "What a sneaky dink.",
      "tier": "foundations"
    },
    {
      "id": "fault",
      "term": "Fault",
      "definition": "A rule violation that ends the rally.",
      "exampleLine": "That's a fault.",
      "tier": "foundations"
    }
  ],
